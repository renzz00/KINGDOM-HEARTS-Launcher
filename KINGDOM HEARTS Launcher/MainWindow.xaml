<Window x:Class="Kingdom_Hearts_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KINGDOM HEARTS Launcher"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/khlauncherlogo.png"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="GameList" Grid.Row="0" MouseDoubleClick="GameList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel x:Name="Row">
                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Installed}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1">
            <Button Content="Launch" Margin="0,5,0,0" Height="25" FontWeight="Bold" Click="Launch_Click" IsDefault="True"/>
            <Button Content="Launcher Config" Margin="0,5,0,0" Height="25" Click="LauncherConfigButton_Click"/>
            <Button Content="OpenKH Mod Manager" Margin="0,5,0,0" Height="25" Click="ModManagerButton_Click"/>
            <TextBlock x:Name="ControllerHint" Margin="0,6,0,0" FontSize="11" Foreground="Gray"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Controller: left stick / D-pad to select, A to launch, X for config, Y for OpenKH"/>
        </StackPanel>
    </Grid>
</Window>
