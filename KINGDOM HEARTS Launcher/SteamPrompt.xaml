<Window x:Class="Kingdom_Hearts_Launcher.SteamPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to Steam"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap">
            Add KINGDOM HEARTS Launcher to your Steam library?
            <LineBreak/><LineBreak/>
            You'll be able to start it from Steam, Big Picture and your controller, with its own artwork.
            If Steam is running it will be closed and started again, so save any game you're playing first.
            <LineBreak/><LineBreak/>
            You can also do this later from Launcher Config.
        </TextBlock>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="HintText" Margin="0,10,0,0" FontSize="11" Foreground="Gray"
                   Text="Controller: A to add, B for not now"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PrimaryButton" Content="Add to Steam" Width="110" Height="24" IsDefault="True" Click="Primary_Click"/>
            <Button x:Name="SecondaryButton" Content="Not now" Width="90" Height="24" Margin="6,0,0,0" IsCancel="True" Click="Secondary_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
